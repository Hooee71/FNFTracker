<Window x:Class="FnfTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FnfTracker.App"
        Title="FNF Arena Tracker" Icon="Assets/fnf.ico" Width="1600" Height="920" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#1B1B1F"
        StateChanged="Window_StateChanged">
    <!-- Custom title bar: the app draws its own (see TitleBar below) instead of the standard Windows one.
         Dragging, double-click to maximize, right-click menu, snapping and edge resizing still work. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Rows are two lines tall now (stacked enemies), so centre the other cells vertically. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Matches grid: short values sit centred under their headers (Enemies and Map stay left). -->
        <Style x:Key="CenterCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Enemy names in the Matches grid: dim like plain text until hovered, then underlined.
             On the selected row they take the row's selection text colour so the highlight doesn't wash
             them out (hover still wins, since it's the later trigger). -->
        <Style x:Key="ProfileLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#B3D8DAE0" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E6B450" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Column headers in every table use the WoW-style heading font; cells stay Segoe UI for readability. -->
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFont}" />
        </Style>
        <!-- Header for the centred Matches columns, so the title sits over its values. -->
        <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Title bar buttons: flat, gold on hover, crimson for close. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="#C9B48A" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33D8B56A" />
                                <Setter Property="Foreground" Value="#F2DDA8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55D8B56A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#9B1C1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#6E1414" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Edit / delete mini icons on each Matches row: flat, gold on hover; delete goes crimson. -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#C9B48A" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33D8B56A" />
                                <Setter Property="Foreground" Value="#F2DDA8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55D8B56A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#9B1C1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#6E1414" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <!-- Background art: shows through in the banner (logo + tabs), then a dark veil fades in
             so the tables sit on an almost-solid surface. The veil uses absolute pixels,
             so the banner stays the same height whatever the window size. -->
        <Image Source="Assets/background.jpg" Stretch="UniformToFill" VerticalAlignment="Top"
               HorizontalAlignment="Center" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,320">
                    <GradientStop Color="#4D1B1B1F" Offset="0" />
                    <GradientStop Color="#8C1B1B1F" Offset="0.35" />
                    <GradientStop Color="#EB1B1B1F" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Soft dark vignette behind the mascot art so the bright sword in the background
             doesn't show through the characters. Hidden on tabs without art. -->
        <Rectangle x:Name="MascotScrim" Width="660" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-74,-95,0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#CC0E0B0D" Offset="0" />
                    <GradientStop Color="#CC0E0B0D" Offset="0.45" />
                    <GradientStop Color="#000E0B0D" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Title bar: dark band over the background art, thin gold rule underneath. -->
        <Border x:Name="TitleBar" Height="36" VerticalAlignment="Top" Panel.ZIndex="20"
                BorderBrush="#806A4A22" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E60E0B0D" Offset="0" />
                    <GradientStop Color="#B30E0B0D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize"
                            Click="Minimize_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            ToolTip="Maximize" Click="MaxRestore_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close"
                            Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/fnf.ico" Width="20" Height="20" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="&#x25C6;" Foreground="#806A4A22" FontSize="8" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="FNF Arena Tracker" FontFamily="{DynamicResource HeadingFont}" FontSize="15"
                               Foreground="#D8B56A" VerticalAlignment="Center" />
                    <TextBlock Text="&#x25C6;" Foreground="#806A4A22" FontSize="8" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="16,46,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Image DockPanel.Dock="Left" Source="Assets/logo.png" Height="54" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"
                       ToolTip="FNF Arena Tracker" />
                <!-- Session record sits beside the logo; the right side belongs to the mascot art. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="32,0,0,0">
                    <TextBlock x:Name="SessionText" FontSize="17" FontFamily="{DynamicResource HeadingFont}" Margin="0,0,24,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="OverallText" FontSize="17" FontFamily="{DynamicResource HeadingFont}" Opacity="0.75" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_SelectionChanged">

                <!-- ============ MATCHES ============ -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="Matches" FontSize="16" FontFamily="{DynamicResource HeadingFont}" />
                    </TabItem.Header>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Games come in from the addon; this strip just counts them and says how to fix one.
                             It also gives the mascot art (top right) room above the table. The right margin
                             keeps the text out from under the art. -->
                        <DockPanel Grid.Row="0" Height="48" Margin="2,0,280,0">
                            <TextBlock x:Name="MatchCountText" DockPanel.Dock="Left" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                       FontFamily="{DynamicResource HeadingFont}" FontSize="16" />
                            <TextBlock VerticalAlignment="Bottom" Margin="16,0,0,9" Opacity="0.5" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Text="Double-click a game (or use its pencil) to fix it · Del removes the selected game" />
                        </DockPanel>

                        <DataGrid x:Name="MatchesGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserResizeRows="False"
                                  Sorting="MatchesGrid_Sorting"
                                  MouseDoubleClick="MatchesGrid_MouseDoubleClick"
                                  PreviewKeyDown="MatchesGrid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Night" HeaderStyle="{StaticResource CenterHeader}" Binding="{Binding Night}" SortMemberPath="PlayedAt" Width="Auto" MinWidth="44" ElementStyle="{StaticResource CenterCellText}" />
                                <DataGridTextColumn Header="#" HeaderStyle="{StaticResource CenterHeader}" Binding="{Binding GameNo}" Width="Auto" MinWidth="44" ElementStyle="{StaticResource CenterCellText}" />
                                <DataGridTextColumn Header="Time" HeaderStyle="{StaticResource CenterHeader}" Binding="{Binding Time}" SortMemberPath="PlayedAt" Width="Auto" MinWidth="44" ElementStyle="{StaticResource CenterCellText}" />
                                <DataGridTextColumn Header="W/L" HeaderStyle="{StaticResource CenterHeader}" Binding="{Binding ResultText}" Width="Auto" MinWidth="44">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}">
                                            <Setter Property="Foreground" Value="{Binding ResultBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Enemies" SortMemberPath="Enemies" Width="2*" MinWidth="270">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- One enemy per line: class-colour bar, spec + class, then name. -->
                                            <ItemsControl ItemsSource="{Binding EnemyChips}" VerticalAlignment="Center" Margin="0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                                            <Border Width="3" CornerRadius="1" Background="{Binding Brush}" Margin="0,2,8,2" />
                                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Name}" Opacity="0.55" FontSize="12"
                                                                       Visibility="{Binding PlainNameVisibility}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding LinkVisibility}"
                                                                       ToolTip="Open on check-pvp.fr">
                                                                <Hyperlink NavigateUri="{Binding ProfileUrl}" Style="{StaticResource ProfileLink}"
                                                                           RequestNavigate="ProfileLink_RequestNavigate"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Map, with Dampening at the end on a second, dimmer line (addon games that read it). -->
                                <DataGridTemplateColumn Header="Map" SortMemberPath="Map" Width="*" MinWidth="185">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,4">
                                                <TextBlock Text="{Binding Map}" />
                                                <TextBlock Text="{Binding Dampening}" Opacity="0.55" FontSize="12" Margin="0,1,0,0"
                                                           Visibility="{Binding DampeningVisibility}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Rating" HeaderStyle="{StaticResource CenterHeader}" Binding="{Binding Rating}" Width="Auto" MinWidth="44" ElementStyle="{StaticResource CenterCellText}" />
                                <DataGridTextColumn Header="+/-" HeaderStyle="{StaticResource CenterHeader}" Binding="{Binding Change}" Width="Auto" MinWidth="44">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}">
                                            <Setter Property="Foreground" Value="{Binding ChangeBrush}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Fixed-content columns size to fit both header (heading font + sort arrow) and cells. -->
                            <DataGridTextColumn Header="Their MMR" HeaderStyle="{StaticResource CenterHeader}" Binding="{Binding EnemyMmr}" Width="Auto" MinWidth="44" ElementStyle="{StaticResource CenterCellText}" />
                                <!-- Our damage and healing vs. the enemy team's, stacked like the Enemies column.
                                     Sorts by the damage gap; hover for the raw totals, per-second rates and length. -->
                                <DataGridTemplateColumn Header="DPS/HPS" HeaderStyle="{StaticResource CenterHeader}" SortMemberPath="DpsVs" Width="Auto" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Output}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Margin="0,4" ToolTip="{Binding OutputTip}" Background="Transparent">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Label, diverging bar (red grows left, green grows right of the centre tick), number. -->
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="18" />
                                                                <ColumnDefinition Width="18" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Opacity="0.55" FontSize="11" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" HorizontalAlignment="Right" Height="6" CornerRadius="1,0,0,1"
                                                                    Width="{Binding NegWidth}" Background="{Binding Brush}" VerticalAlignment="Center" />
                                                            <Border Grid.Column="2" HorizontalAlignment="Left" Height="6" CornerRadius="0,1,1,0"
                                                                    Width="{Binding PosWidth}" Background="{Binding Brush}" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" Grid.ColumnSpan="2" Width="1" Height="10" Background="#40FFFFFF"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Text}" Foreground="{Binding Brush}"
                                                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Edit / delete icons, always the last column. Dim until the row is hovered or selected. -->
                                <DataGridTemplateColumn Header="" Width="66" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Opacity" Value="0.4" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource RowIconButton}" Content="&#xE70F;"
                                                        ToolTip="Edit this game" Click="EditRow_Click" />
                                                <Button Style="{StaticResource RowDeleteButton}" Content="&#xE74D;" Margin="2,0,0,0"
                                                        ToolTip="Delete this game" Click="DeleteRow_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ============ STATS ============ -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="Stats" FontSize="16" FontFamily="{DynamicResource HeadingFont}" />
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,20,12">
                            <!-- Which games the stats cover. -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,400,0">
                                <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,10,0"
                                           FontFamily="{DynamicResource HeadingFont}" FontSize="16" />
                                <ComboBox x:Name="RangeBox" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="Range_Changed" />

                                <StackPanel x:Name="NightPanel" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
                                    <Button Content="&#x25C0;" Padding="10,4" Click="PrevNight_Click"
                                            ToolTip="Previous night you played" />
                                    <DatePicker x:Name="NightPicker" Width="150" Margin="6,0"
                                                SelectedDateChanged="NightPicker_Changed" />
                                    <Button Content="&#x25B6;" Padding="10,4" Click="NextNight_Click"
                                            ToolTip="Next night you played" />
                                </StackPanel>

                                <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
                                    <DatePicker x:Name="FromPicker" Width="150" SelectedDateChanged="CustomRange_Changed"
                                                ToolTip="First night (leave blank for no limit)" />
                                    <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0" />
                                    <DatePicker x:Name="ToPicker" Width="150" SelectedDateChanged="CustomRange_Changed"
                                                ToolTip="Last night (leave blank for no limit)" />
                                </StackPanel>

                                <TextBlock x:Name="RangeSummary" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.7" />
                            </WrapPanel>

                            <WrapPanel x:Name="SummaryCards" Margin="0,14,400,0" />

                            <TextBlock Text="Rating" Style="{StaticResource SectionHeader}" Margin="0,10,0,6" />
                            <WrapPanel x:Name="RatingCards" />

                            <TextBlock Text="Rating history (each point is a game; dashed lines separate nights)"
                                       Style="{StaticResource SectionHeader}" />
                            <Border Height="220" CornerRadius="8" Background="#14FFFFFF" Padding="4">
                                <Canvas x:Name="RatingCanvas" ClipToBounds="True" SizeChanged="RatingCanvas_SizeChanged" />
                            </Border>

                            <!-- Two independent columns: each table goes under whichever column is shorter,
                                 so a short table isn't padded out to the height of the tallest one. -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="StatColumnLeft" Grid.Column="0" />
                                <StackPanel x:Name="StatColumnRight" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ SETTINGS ============ -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="Settings" FontSize="16" FontFamily="{DynamicResource HeadingFont}" />
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,20,12" MaxWidth="580" HorizontalAlignment="Left">
                            <TextBlock Text="You" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                            <TextBlock Text="Your name (stamped on games you record, so merged files show who logged what)"
                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,3" />
                            <TextBox x:Name="MyNameBox" />
                            <TextBlock Text="Your realm and region (enemy names link to their check-pvp.fr profile; the realm fills in for enemies on your own realm)"
                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,10,0,3" />
                            <DockPanel>
                                <ComboBox x:Name="RegionBox" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" />
                                <TextBox x:Name="HomeRealmBox" />
                            </DockPanel>
                            <Button Content="Save settings" Padding="16,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Click="SaveSettings_Click" />

                            <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" Margin="0,24,0,6" />
                            <TextBlock x:Name="VersionText" Opacity="0.75" TextWrapping="Wrap" />
                            <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates when the app starts" Margin="0,8,0,0"
                                      Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />
                            <StackPanel x:Name="UpdateButtons" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Check for updates" Padding="12,5" Click="CheckUpdates_Click" />
                                <Button Content="Releases page" Padding="12,5" Margin="8,0,0,0" Click="ReleasesPage_Click" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" />

                            <TextBlock Text="Season" Style="{StaticResource SectionHeader}" Margin="0,24,0,6" />
                            <TextBlock Text="Season start: used by &quot;This season&quot; on the Stats tab and the season record in the header."
                                       Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <DatePicker x:Name="SeasonStartPicker" Width="170" SelectedDateChanged="SeasonStart_Changed" />
                                <Button Content="Clear" Padding="12,4" Margin="8,0,0,0" Click="ClearSeason_Click" />
                            </StackPanel>

                            <TextBlock Text="World of Warcraft" Style="{StaticResource SectionHeader}" Margin="0,24,0,6" />
                            <TextBlock Text="WoW folder (the one that contains _retail_)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,3" Margin="8,0,0,0" Click="BrowseWow_Click" />
                                <TextBox x:Name="WowFolderBox" />
                            </DockPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Install / update addon" Padding="12,5" Margin="0,0,8,8" Click="InstallAddon_Click" />
                                <Button Content="Import now" Padding="12,5" Margin="0,0,8,8" Click="ImportNow_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="AddonStatusText" TextWrapping="Wrap" Opacity="0.85" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.6" Margin="0,6,0,0"
                                       Text="WoW saves the addon's games when you log out, exit or type /reload. The app picks them up automatically at that moment (if it's open) and every time it starts." />

                            <TextBlock Text="Your data" Style="{StaticResource SectionHeader}" Margin="0,24,0,6" />
                            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" Opacity="0.75" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,10"
                                       Text="To share with your partner: Export, send them the file, and they use Merge. Games you both logged are detected and skipped." />
                            <WrapPanel>
                                <Button Content="Open data folder" Padding="12,5" Margin="0,0,8,8" Click="OpenFolder_Click" />
                                <Button Content="Export for partner…" Padding="12,5" Margin="0,0,8,8" Click="Export_Click" />
                                <Button Content="Merge partner's file…" Padding="12,5" Margin="0,0,8,8" Click="Merge_Click" />
                                <Button Content="Export CSV…" Padding="12,5" Margin="0,0,8,8" Click="ExportCsv_Click" />
                            </WrapPanel>

                            <TextBlock Text="Website" Style="{StaticResource SectionHeader}" Margin="0,24,0,6" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,4"
                                       Text="Publish the Matches and Stats pages to a free GitHub Pages site anyone can open. Only one of you needs to set this up; the user guide walks through it." />
                            <TextBlock Text="GitHub repo for the site (owner/name, must be public)" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                            <TextBox x:Name="PublishRepoBox" ToolTip="e.g. Hooee71/fnf-stats" />
                            <TextBlock Text="Access token (fine-grained, that repo only: Contents, Pages and Administration, read and write)"
                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,10,0,3" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Forget token" Padding="12,3" Margin="8,0,0,0" Click="ForgetToken_Click" />
                                <PasswordBox x:Name="PublishTokenBox" ToolTip="Paste the token here. It's stored encrypted on this PC only, never in the file you send your partner." />
                            </DockPanel>
                            <TextBlock x:Name="TokenStateText" Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <CheckBox x:Name="AutoPublishCheck" Content="Publish automatically when the addon brings in new games" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Save website settings" Padding="12,5" Margin="0,0,8,8" Click="SavePublish_Click" />
                                <Button x:Name="PublishNowButton" Content="Publish now" Padding="12,5" Margin="0,0,8,8" Click="Publish_Click" />
                                <Button Content="Open site" Padding="12,5" Margin="0,0,8,8" Click="OpenSite_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="PublishStatusText" TextWrapping="Wrap" Opacity="0.85" />

                            <TextBlock Text="Follow a friend's site" Style="{StaticResource SectionHeader}" Margin="0,24,0,6" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,4"
                                       Text="Keep this app in step with a friend's published FNF site: their games come in, and their edits and deletes follow. Games you recorded yourself, and your notes, are left alone. No GitHub account needed." />
                            <TextBlock Text="Site address (e.g. https://name.github.io/fnf-stats/)" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                            <TextBox x:Name="SyncSiteBox" ToolTip="Paste the address of their site, or their repo as owner/name" />
                            <CheckBox x:Name="SyncOnStartCheck" Content="Sync every time the app starts" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="SyncNowButton" Content="Sync now" Padding="12,5" Margin="0,0,8,8" Click="SyncNow_Click" />
                                <Button Content="Stop following" Padding="12,5" Margin="0,0,8,8" Click="StopFollowing_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="SyncStatusText" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Bottom bar: status messages on the left, update banner on the right when one is available. -->
            <DockPanel Grid.Row="2" Margin="2,8,0,0">
                <!-- One-click publish of the website; shown once it's set up in Settings. -->
                <Button x:Name="PublishBarButton" DockPanel.Dock="Right" Content="Publish site" Padding="14,4" Margin="8,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="Publish_Click"
                        ToolTip="Update the public Matches and Stats pages" />
                <Border x:Name="UpdateBanner" DockPanel.Dock="Right" Visibility="Collapsed" CornerRadius="6"
                        Padding="12,4" Background="#33D8B56A" BorderBrush="#806A4A22" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Foreground="#F2DDA8"
                                   FontFamily="{DynamicResource HeadingFont}" FontSize="14" />
                        <Button x:Name="UpdateNowButton" Content="Update now" Padding="12,3" Margin="12,0,0,0"
                                Click="UpdateNow_Click" />
                        <Button Content="What's new" Padding="12,3" Margin="6,0,0,0" Click="WhatsNew_Click" />
                        <Button x:Name="UpdateLaterButton" Content="Later" Padding="10,3" Margin="6,0,0,0"
                                Click="UpdateLater_Click" />
                    </StackPanel>
                </Border>
                <!-- Status pill: hidden until a message arrives, then flashes in and fades away
                     after a while. Driven by Status() in the code-behind. -->
                <Border x:Name="StatusPill" HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="6" Padding="10,4" BorderThickness="1" Opacity="0"
                        Background="#33E6B450" BorderBrush="#AAE6B450">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="StatusPillShift" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Fill="#E6B450" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#F2DDA8"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Mascot art: top-right, fading out downward.
                 Each tab has its own art (or none); see UpdateMascotArt in the code-behind.
                 Drawn on top but ignores the mouse, so everything under it still works. -->
            <Image x:Name="MascotArt" Grid.Row="0" Grid.RowSpan="3" Source="Assets/mascots.png"
                   Width="390" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-10,24,0" Opacity="0.8" IsHitTestVisible="False" Panel.ZIndex="10"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.45" />
                        <GradientStop Color="#00000000" Offset="0.95" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>
        </Grid>
    </Grid>
</Window>
