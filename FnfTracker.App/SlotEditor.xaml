<UserControl x:Class="FnfTracker.App.SlotEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,10">
        <TextBlock x:Name="HeaderText" Opacity="0.75" Margin="0,0,0,3" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Swatch" Grid.Column="0" CornerRadius="2" Background="#555" />
            <ComboBox x:Name="ClassBox" Grid.Column="1" Margin="6,0,0,0"
                      ToolTip="Class (type to jump, e.g. 'Ro' for Rogue)"
                      SelectionChanged="ClassBox_SelectionChanged" />
            <ComboBox x:Name="SpecBox" Grid.Column="3" ToolTip="Spec" />
        </Grid>
        <Grid x:Name="NameGrid" Margin="11,6,0,0">
            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" />
            <TextBlock x:Name="NameHint" Text="Name-Realm (optional)" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.45" />
        </Grid>
    </StackPanel>
</UserControl>
