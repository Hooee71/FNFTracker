<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner (no test framework packages needed). Exit code = number of failures.
       Run with: dotnet run (project tests/FnfTracker.Tests) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FnfTracker.Core\FnfTracker.Core.csproj" />
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
